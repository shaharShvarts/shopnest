# Copy to .env.staging; chmod 600. Never commit the private file.
# Generate separate values for EACH environment; blanks fail Compose validation.
STAGING_DB_PASSWORD=
# openssl rand -base64 32
STAGING_PAYMENT_ENCRYPTION_KEY=
APP_ENV=staging
NODE_ENV=production
# Optional Google test OAuth client; register each callback separately.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://staging.shopnest.co.il/api/customer-auth/google/callback
# Cardcom: test credentials only, entered via authenticated admin.
